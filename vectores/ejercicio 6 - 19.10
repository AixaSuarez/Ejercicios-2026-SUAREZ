#include <stdio.h>

int main() {
    int vector[5];
    int i, opcion, posicion, valor;

    for (i = 0; i < 5; i++) {
        printf("Ingrese un valor: ");
        scanf("%d", &vector[i]);
    }
      
while(opcion!=4){
    printf("1. Consultar un valor\n");
    printf("2. Modificar un valor\n");
    printf("3. Imprimir el vector\n");
    printf("4. Finaliz\n");
    printf("Ingrese una opcion: ");
    scanf("%d", &opcion);
    if (opcion == 1) {
        printf("Ingrese la posicion (1 a 5): ");
        scanf("%d", &posicion);

        printf("Valor: %d\n", vector[posicion - 1]);
    }

    if (opcion == 2) {
        printf("Ingrese la posicion (1 a 5): ");
        scanf("%d", &posicion);

        printf("Ingrese el nuevo valor: ");
        scanf("%d", &valor);

        vector[posicion - 1] = valor;
    }

    if (opcion == 3) {
        for (i = 0; i < 5; i++) {
            printf("el numero ingresado es: %d \n", vector[i]);

    }
}
}
    return 0;
}
