#include <stdio.h>
int main()
{
    int matriz [3][2][3];
    int j, i,b;

    for (i=0;i<3;i++){
        for(j=0; j<3;j++){
            for(b=0;b<3;b++){
            printf("\ningrese el valor de la posicion [%d][%d][%d]: ", i,j,b);
            scanf("%d", &matriz[i][j][b]);
            }
        }
    }

    return 0;
}
